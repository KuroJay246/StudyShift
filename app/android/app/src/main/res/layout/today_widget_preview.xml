<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/studyshift_widget_background"
    android:gravity="top"
    android:orientation="vertical"
    android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="TODAY" android:textColor="@color/studyshift_widget_work"
        android:textSize="12sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" android:text="Your schedule"
        android:textColor="@color/studyshift_widget_work" android:textSize="10sp"
        android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:text="Work, study and plans at a glance"
        android:textColor="@color/studyshift_widget_primary" android:textSize="16sp"
        android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:text="Add schedule items to see your day here."
        android:textColor="@color/studyshift_widget_secondary" android:textSize="12sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="UP NEXT"
        android:textColor="@color/studyshift_widget_study" android:textSize="10sp"
        android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:text="Your next event"
        android:textColor="@color/studyshift_widget_primary" android:textSize="14sp"
        android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:text="Your saved schedule appears here."
        android:textColor="@color/studyshift_widget_secondary" android:textSize="11sp" />
</LinearLayout>
