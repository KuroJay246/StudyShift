# Keep generated product concept boards reviewable; runtime/private images stay ignored above.
!/.impeccable/
!/.impeccable/mocks/
!/.impeccable/mocks/decision/
!/.impeccable/mocks/decision/*.png
!/.impeccable/mocks/decision/*.png.json

# Approved StudyShift runtime branding assets are source inputs, not private media.
!app/assets/branding/studyshift-symbol*.png
!app/assets/branding/studyshift-icon-*.png
!app/assets/branding/studyshift-launcher-icon.png
!app/android/app/src/main/res/drawable-nodpi/studyshift_symbol_*.png

# Project-scoped SDK installs (never commit binaries)
.devtools/
.tools/

# Android local device data
.avd/
